rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definition
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Auth tokens NEVER contain custom claims. We must lookup roles if needed.
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Validation Blueprint for Product
    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'price', 'description', 'category', 'image']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.price is number && data.price >= 0 &&
             data.description is string && data.description.size() <= 2000 &&
             data.category is string && data.category.size() <= 100 &&
             data.image is string && data.image.size() <= 1000;
    }

    // Validation Blueprint for User
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'name']) &&
             data.email is string && data.email.size() <= 255 &&
             data.name is string && data.name.size() <= 255;
    }

    // Validation Blueprint for Order
    function isValidOrder(data) {
      return data.keys().hasAll(['userId', 'items', 'total', 'status']) &&
             data.userId == request.auth.uid &&
             data.items is list && data.items.size() > 0 &&
             data.total is number && data.total >= 0 &&
             data.status in ['pending', 'shipped', 'delivered'];
    }

    // Phase 4: Match Blocks
    match /products/{productId} {
      // Secure List Queries: Evaluate resource.data directly
      allow read: if true;
      
      // Allow creation for authenticated users if valid (for seeding)
      // In a real production app, this would be isAdmin()
      allow create: if isSignedIn() && isValidProduct(incoming());
      
      // Updates are restricted
      allow update: if (
        isSignedIn() && isValidProduct(incoming()) && (
          isAdmin() || 
          (incoming().diff(existing()).affectedKeys().hasOnly(['stock', 'rating', 'reviews']))
        )
      );
      
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUser(incoming());
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      // Secure List Queries
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(incoming().userId) && isValidOrder(incoming());
      allow update: if (
        isSignedIn() && (
          isAdmin() || 
          (isOwner(existing().userId) && incoming().diff(existing()).affectedKeys().hasOnly(['status']) && existing().status == 'pending')
        )
      );
      allow delete: if isAdmin();
    }

    // Admin lookup collection
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable via Firebase Console or Admin SDK
    }
  }
}
